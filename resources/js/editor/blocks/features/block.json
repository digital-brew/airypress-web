{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "airypress/features",
  "title": "Features",
  "category": "airypress",
  "icon": "grid-view",
  "description": "Heading with intro text above a grid of colored feature cards, each with an illustration or image.",
  "textdomain": "radicle",
  "supports": {
    "html": false,
    "align": ["full"]
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "anchor": {
      "type": "string",
      "default": "features"
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": []
    },
    "colors": {
      "type": "object",
      "default": {}
    }
  }
}
