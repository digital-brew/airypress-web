{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "airypress/highlights",
  "title": "Highlights",
  "category": "airypress",
  "icon": "screenoptions",
  "description": "Row of icon cards with a short title and line of text.",
  "textdomain": "radicle",
  "supports": {
    "html": false,
    "align": ["full"]
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "anchor": {
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": []
    },
    "colors": {
      "type": "object",
      "default": {}
    }
  }
}
