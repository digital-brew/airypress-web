{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "airypress/hero",
  "title": "Hero",
  "category": "airypress",
  "icon": "star-filled",
  "description": "Brand-colored opening panel with a centred headline, buttons and a product visual.",
  "textdomain": "radicle",
  "supports": {
    "html": false,
    "align": ["full"]
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "anchor": {
      "type": "string",
      "default": ""
    },
    "badge": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "primaryText": {
      "type": "string",
      "default": ""
    },
    "primaryUrl": {
      "type": "string",
      "default": ""
    },
    "secondaryText": {
      "type": "string",
      "default": ""
    },
    "secondaryUrl": {
      "type": "string",
      "default": ""
    },
    "stickerOne": {
      "type": "string",
      "default": ""
    },
    "stickerTwo": {
      "type": "string",
      "default": ""
    },
    "stickerThree": {
      "type": "string",
      "default": ""
    },
    "mediaAlt": {
      "type": "string",
      "default": ""
    },
    "mediaId": {
      "type": "number",
      "default": 0
    },
    "colors": {
      "type": "object",
      "default": {}
    }
  }
}
