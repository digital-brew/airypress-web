{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "airypress/video",
  "title": "Video",
  "category": "airypress",
  "icon": "video-alt3",
  "description": "Dark section: eyebrow, heading and intro, a framed muted loop with a play button that opens the demo in a modal (1080p, with an optional 4K switch), and chapter pills that jump to a moment.",
  "textdomain": "radicle",
  "supports": {
    "html": false,
    "align": ["full"]
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "anchor": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "backgroundVideoId": {
      "type": "number",
      "default": 0
    },
    "backgroundVideoUrl": {
      "type": "string",
      "default": ""
    },
    "videoUrl": {
      "type": "string",
      "default": ""
    },
    "posterUrl": {
      "type": "string",
      "default": ""
    },
    "embedUrl": {
      "type": "string",
      "default": ""
    },
    "caption": {
      "type": "string",
      "default": ""
    },
    "videoId": {
      "type": "number",
      "default": 0
    },
    "video4kId": {
      "type": "number",
      "default": 0
    },
    "video4kUrl": {
      "type": "string",
      "default": ""
    },
    "posterId": {
      "type": "number",
      "default": 0
    },
    "overlayOpacity": {
      "type": "number",
      "default": 45
    },
    "chapters": {
      "type": "array",
      "default": []
    },
    "colors": {
      "type": "object",
      "default": {}
    }
  }
}
